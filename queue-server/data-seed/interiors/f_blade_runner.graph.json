      "cue": null,
      "quote": "Hello, Wrigley.",
      "block": 94
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Mr. Deetchum isn't taking very",
      "block": 95
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "good care of you people.",
      "block": 96
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Whoops.",
      "block": 97
    },
    {
      "speaker": "p13",
      "to": null,
      "stance": "ally",
      "cue": null,
      "quote": "This is my Uncle Roy, Sebastian.",
      "block": 98
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": null,
      "quote": "Hello, glad to meet you.",
      "block": 99
    },
    {
      "speaker": "p13",
      "to": null,
