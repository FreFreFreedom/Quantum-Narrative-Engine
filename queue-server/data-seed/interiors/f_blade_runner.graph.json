      "stance": "opp",
      "cue": null,
      "quote": "I want to know what's going on.",
      "block": 107
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "There's only three of us left.",
      "block": 108
    },
    {
      "speaker": "p13",
      "to": null,
      "stance": "opp",
      "cue": null,
      "quote": "Then we're stupid and we'll die.",
      "block": 109
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Pris?",
      "block": 110
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "BATTY",
      "quote": "You're our best and only friend.",
      "block": 111
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "ally",
      "cue": "SEBASTIAN",
      "quote": "Thank you.",
      "block": 112
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "When was the last time you cleaned\n                  this place?",
      "block": 113
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Hmmm?",
      "block": 114
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "Have you ever cleaned your\n                  apartment?",
      "block": 115
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Don't be fooled by appearances.",
      "block": 116
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "It appears to be dirty -- why don't\n                  you get somebody?",
      "block": 117
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Because they would ruin the\n                  arrangement.",
      "block": 118
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "They could clean around the\n                  arrangement.",
      "block": 119
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "I don't like people snooping around\n                  my stuff.",
      "block": 120
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD'S VOICE",
      "quote": "There's a vacuum in the front room\n                  closet is you wanna give it a try.",
      "block": 121
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Oh no, don't do that.",
      "block": 122
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "But if I don't plug it in how can\n                  I...",
      "block": 123
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Never mind the plug, just go\n                  through the motions.",
      "block": 124
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "But then how can you...",
      "block": 125
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "I don't like the noise.  Just\n                  practice.  Practice makes perfect.",
      "block": 126
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "I'm serious.  Go ahead.  Show me\n                  how you would do it.",
      "block": 127
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "How about under the couch there.\n                  Come on.",
      "block": 128
    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "RACHAEL",
      "quote": "This feels stupid.",
      "block": 129
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "Good for a smart girl to feel\n                  stupid.  Part of your education.",
      "block": 130
    },
    {
      "speaker": "p6",
      "to": "p5",
      "stance": "opp",
      "cue": "RACHAEL",
      "quote": "You're sick, Deckard.",
      "block": 131
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "neu",
      "cue": "DECKARD",
      "quote": "I never felt better.",
      "block": 132
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "STYLES",
      "quote": "Okay, I'll take that now.",
      "block": 133
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "opp",
      "cue": "SEBASTIAN",
      "quote": "Wait!",
      "block": 134
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "SEBASTIAN",
      "quote": "Can't fly without the pilot.",
      "block": 135
    },
    {
      "speaker": "p17",
      "to": null,
      "stance": "neu",
      "cue": "IAN",
      "quote": "Oh!",
      "block": 136
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "neu",
      "cue": "MARY",
      "quote": "Let's go while there is still\n                  time.",
      "block": 137
    },
    {
      "speaker": "p2",
      "to": "p14",
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Where?",
      "block": 138
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "ally",
      "cue": "MARY",
      "quote": "Anywhere.",
      "block": 139
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "BATTY",
      "quote": "What's the point?",
      "block": 140
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "neu",
      "cue": "MARY",
      "quote": "Not to be trapped.",
      "block": 141
    },
    {
      "speaker": "p2",
      "to": "p14",
      "stance": "opp",
      "cue": "BATTY",
      "quote": "You underestimate the trap, Mary.",
      "block": 142
    },
    {
      "speaker": "p2",
      "to": "p12",
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Where are you going, Sebastian?",
      "block": 143
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "SEBASTIAN",
      "quote": "Just thought I'd...",
      "block": 144
    },
    {
      "speaker": "p2",
      "to": "p12",
      "stance": "opp",
      "cue": "BATTY",
      "quote": "No, you stay here with us.  Out\n                  last night together.",
      "block": 145
    },
    {
      "speaker": "p2",
      "to": "p14",
      "stance": "ally",
      "cue": "BATTY",
      "quote": "Think of yourself as a light, Mary.\n                  Shine before you're turned off.",
      "block": 146
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "SEBASTIAN",
      "quote": "Someone is coming here.",
      "block": 147
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "BATTY",
      "quote": "One man.\n                         (he smiles)\n                  He must be good.",
      "block": 148
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "ally",
      "cue": "MARY",
      "quote": "Then go get him.",
      "block": 149
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "opp",
      "cue": "BATTY",
      "quote": "That wouldn't be very sporting.",
      "block": 150
    },
    {
      "speaker": "p13",
      "to": null,
      "stance": "neu",
      "cue": "PRIS",
      "quote": "I want to do it.",
      "block": 151
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "BATTY",
      "quote": "Okay, but don't kill him.  Save a\n                  little for everybody.  A\n                  masterpiece.",
      "block": 152
    },
    {
      "speaker": "p2",
      "to": "p13",
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Turn out the lights, Pris.",
      "block": 153
    },
    {
      "speaker": "p13",
      "to": null,
      "stance": "opp",
      "cue": "PRIS",
      "quote": "Naughty, naughty.",
      "block": 154
    },
    {
      "speaker": "p2",
      "to": "p5",
      "stance": "opp",
      "cue": "BATTY",
      "quote": "It's time to die.",
      "block": 155
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Ah!",
      "block": 156
    },
    {
      "speaker": "p2",
      "to": "p5",
      "stance": "ally",
      "cue": "BATTY",
      "quote": "That's for you.",
      "block": 157
    },
    {
      "speaker": "p2",
      "to": "p5",
      "stance": "opp",
      "cue": "BATTY",
      "quote": "Well?",
      "block": 158
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "BATTY",
      "quote": "Crap.",
      "block": 159
    }
