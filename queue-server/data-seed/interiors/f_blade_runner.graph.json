      "quote": "soon as I can.",
      "block": 90
    },
    {
      "speaker": "p5",
      "to": null,
      "stance": "opp",
      "cue": null,
      "quote": "Fuck you, then.",
      "block": 91
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Mr. Deetchum?  Hello?",
      "block": 92
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Now, now, Waddles.",
      "block": 93
    },
    {
      "speaker": "p12",
      "to": null,
