    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "ADA (VOICE OVER)",
      "quote": "My will has chosen life!?",
      "block": 124
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "ADA (VOICE OVER)",
      "quote": "I teach piano now in Nelson.",
