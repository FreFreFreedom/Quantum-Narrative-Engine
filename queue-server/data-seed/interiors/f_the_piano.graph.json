      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "ADA (VOICE OVER)",
      "quote": "still so bad I am ashamed. I",
      "block": 127
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "ADA (VOICE OVER)",
      "quote": "At night! I think of my piano",
      "block": 128
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "ADA (VOICE OVER)",
      "quote": "in its ocean grave, and",
      "block": 129
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "ADA (VOICE OVER)",
      "quote": "sometimes of myself floating",
      "block": 130
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "ally",
      "cue": "ADA (VOICE OVER)",
      "quote": "above it. Down there everything",
