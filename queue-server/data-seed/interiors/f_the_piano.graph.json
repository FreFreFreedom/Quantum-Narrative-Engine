      "quote": "Say it again, just you.",
      "block": 119
    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": "BIG SISTER",
      "quote": "Dear George you have my heart, \n               Ada McGrath.",
