    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": "BIG SISTER",
      "quote": "Running writing, we haven't \n               done that yet.",
      "block": 110
    },
    {
      "speaker": "p23",
      "to": null,
      "stance": "neu",
      "cue": "READING GIRL",
      "quote": "Myrtle can read it, her mother \n               taught her.",
