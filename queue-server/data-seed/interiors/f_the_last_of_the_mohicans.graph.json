      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "CHINGACHGOOK",
      "quote": "speed, your strength ...",
      "block": 3
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "CHINGACHGOOK",
      "quote": "Halloo! John Cameron!",
      "block": 4
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "CAMERON",
      "quote": "Alexandria! Set three more places.",
      "block": 5
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "CAMERON",
      "quote": "How is Chingachgook, then?",
      "block": 6
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "CHINGACHGOOK",
      "quote": "The Master of Life is good. Another year pass ...",
      "block": 7
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "CHINGACHGOOK",
      "quote": "How is it with you, John?",
      "block": 8
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "CAMERON",
      "quote": "Gettin' along. Yes, it is.",
      "block": 9
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "CAMERON",
      "quote": "Nathaniel.",
      "block": 10
    },
    {
      "speaker": "p3",
      "to": null,
      "stance": "neu",
      "cue": "HAWKEYE",
      "quote": "Hello John. Cleared another quarter, I see.",
      "block": 11
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "CAMERON",
      "quote": "Yes, I did.",
