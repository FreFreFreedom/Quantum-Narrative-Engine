      "quote": "I called dibs...",
      "block": 116
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "neu",
      "cue": "SLAVEDRIVER",
      "quote": "How is she?",
      "block": 117
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "WHOREMONGER",
      "quote": "Tainted.",
      "block": 118
    },
    {
      "speaker": "p9",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "The inspiration! Where have you\n            been hiding?",
      "block": 119
    },
    {
      "speaker": "p9",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Finish her.",
      "block": 120
    },
    {
      "speaker": "p17",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "On your knees!",
      "block": 121
    },
    {
      "speaker": "p9",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "All right six more.",
      "block": 122
    },
    {
      "speaker": "p18",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Freeze!",
      "block": 123
    },
    {
      "speaker": "p18",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Oh no... Come on.",
      "block": 124
    },
    {
      "speaker": "p18",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Are you hurt?",
      "block": 125
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "The baby...",
      "block": 126
    },
    {
      "speaker": "p19",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "This way.    Hurry! Hurry!",
      "block": 127
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "(relieved)\n          It’s me. It’s me.",
      "block": 128
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "What’s happening?",
      "block": 129
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "I don’t know. I have to take you\n          somewhere safe.",
      "block": 130
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "There!   OUT!",
      "block": 131
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "No, it’s too dangerous.   Come with\n          me, quietly.",
      "block": 132
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "The door!     The door!",
      "block": 133
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "No, this way.",
      "block": 134
    },
    {
      "speaker": "p20",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "It’s him, the poet! He hasn’t\n            forsaken us after all!",
      "block": 135
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Come, we need to hurry.    Stay\n            close!",
      "block": 136
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Get back!",
      "block": 137
    },
    {
      "speaker": "p21",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Help us! / We’re hungry. / We’re\n            lost. / Fuck him! / He abandoned\n            us.",
      "block": 138
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "I’m sorry.     I can’t.",
      "block": 139
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "I’m sorry!     I will not forget you.",
      "block": 140
    },
    {
      "speaker": "p11",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Up here!",
      "block": 141
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "They will protect us.",
      "block": 142
    },
    {
      "speaker": "p11",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Give me your hand!",
      "block": 143
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Get back!     I will return!",
      "block": 144
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Sit here.     Rest.",
      "block": 145
    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "I’m a doctor! I’m a doctor.",
      "block": 146
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "A doctor! Help her please.     I’ll\n          be right back.",
      "block": 147
    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Look at me. Listen to my voice.\n          The baby’s almost here.",
      "block": 148
    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Now just push! Yes, yes, you have\n          to push.",
      "block": 149
    },
    {
      "speaker": "p22",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Yes, you’re doing very good.    I can\n          feel the head--",
      "block": 150
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Please move, I’ve got her.    Come.\n          I’ve got you now.",
      "block": 151
    },
    {
      "speaker": "p11",
      "to": null,
      "stance": "neu",
      "cue": null,
      "quote": "Wait, I can help!",
      "block": 152
    },
    {
      "speaker": "p11",
      "to": null,
      "stance": "neu",
      "cue": "ZEALOT (O.S.)",
      "quote": "Do you hear that? That’s the sound\n          of life, the sound of humanity.\n          His cry of love. His love for you.",
      "block": 153
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "HIM",
      "quote": "Please stop. Stop.      STOP!",
      "block": 154
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "(to the crowd)",
      "quote": "Go away! Leave her alone!     What\n          are you doing?",
      "block": 155
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "HIM",
      "quote": "Look what they’ve done to you.",
      "block": 156
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "(to the crowd)",
      "quote": "What are you doing?!    WHAT ARE YOU\n          DOING?",
      "block": 157
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "opp",
      "cue": "MOTHER",
      "quote": "They killed my baby. You killed\n          him. You killed him.",
      "block": 158
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "ally",
      "cue": "HIM",
      "quote": "I am so sorry. They just wanted to\n          see him, they just wanted to touch\n          him, and then they... It’s\n          horrible. I’m sorry. I’m so\n          sorry.",
      "block": 159
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "What are you talking about?",
      "block": 160
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "opp",
      "cue": "MOTHER",
      "quote": "They butchered our son.",
      "block": 161
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "I know.",
      "block": 162
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "opp",
      "cue": "MOTHER",
      "quote": "You’re insane.",
      "block": 163
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "NOOOOO!",
      "block": 164
    },
    {
      "speaker": "p1",
      "to": "p8",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "Murderers!",
      "block": 165
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "opp",
      "cue": "(at HIM)",
      "quote": "Murderer.",
      "block": 166
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "opp",
      "cue": "MOTHER",
      "quote": "It’s time to get the fuck out of my\n          house!",
      "block": 167
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "HIM (O.S.)",
      "quote": "No. Don’t! Please, come back!\n          Don’t leave me.",
      "block": 168
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "(understands)",
      "quote": "No.",
      "block": 169
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "neu",
      "cue": "(to crowd)",
      "quote": "Stop! Please!     Hold on!",
      "block": 170
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "(to Mother)",
      "quote": "Don’t. Please don’t.     I love you.",
      "block": 171
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "opp",
      "cue": "MOTHER",
      "quote": "And you gave it all away.",
      "block": 172
    },
    {
      "speaker": "p2",
      "to": null,
      "stance": "opp",
      "cue": "HIM",
      "quote": "No!   No!   NO!",
      "block": 173
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "What are you?",
      "block": 174
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "Me?    I, am I. You?   You were home.",
      "block": 175
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "Where are you taking me?",
      "block": 176
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "The beginning.",
      "block": 177
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "It won’t hurt much longer.",
      "block": 178
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "What hurts me the most is that I\n          wasn’t enough.",
      "block": 179
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "It’s not your fault. Nothing is\n          ever enough. I couldn’t create if\n          it was. And I have to. That’s\n          what I do. That’s what I am. And\n          now I must try it all again.",
      "block": 180
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "(asks)",
      "quote": "Just let me go.",
      "block": 181
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "I need one last thing.",
      "block": 182
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "I have nothing left to give.",
      "block": 183
    },
    {
      "speaker": "p2",
      "to": "p1",
      "stance": "neu",
      "cue": "HIM",
      "quote": "Your love.\n                 (he points at her chest)\n             It’s still there isn’t it?",
      "block": 184
    },
    {
      "speaker": "p1",
      "to": "p2",
      "stance": "neu",
      "cue": "MOTHER",
      "quote": "Go ahead.    Take it.",
      "block": 185
    },
    {
      "speaker": "p23",
      "to": null,
      "stance": "neu",
      "cue": "NEW WOMAN",
      "quote": "Baby?",
      "block": 186
    }
