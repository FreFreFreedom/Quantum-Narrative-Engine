    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "HIGEN (subtitles)",
      "quote": "The branch.",
      "block": 111
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "Wood.    Ede.",
      "block": 112
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "HIGEN (subtitles)",
      "quote": "The branch burns.",
      "block": 113
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "Eda ga...",
      "block": 114
    },
    {
      "speaker": "p12",
      "to": null,
      "stance": "neu",
      "cue": "HIGEN",
      "quote": "Eda ga moeru.",
      "block": 115
    },
    {
      "speaker": "p10",
      "to": null,
      "stance": "neu",
      "cue": "TAKA",
      "quote": "No, please.",
      "block": 116
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN (insistent)",
      "quote": "Hai.",
      "block": 117
    },
    {
      "speaker": "p10",
      "to": null,
      "stance": "neu",
      "cue": "TAKA (subtitles)",
      "quote": "Japanese men do not help with this.",
      "block": 118
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN (subtitles)",
      "quote": "I am not Japanese.",
      "block": 119
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "You're always so polite. What\n                must you be thinking [feeling]?\n                [Do you miss him that much?] Was\n                he good to you? I hope he was.",
      "block": 120
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "I’m sorry.   Gomen n’sai.",
      "block": 121
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "Gomen n’sai... Your husband,\n                Hirotaro.",
      "block": 122
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "neu",
      "cue": "UJIO",
      "quote": "Lord, please go inside.",
      "block": 123
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "The women, children!",
      "block": 124
    },
    {
      "speaker": "p10",
      "to": "p12",
      "stance": "neu",
      "cue": "TAKA",
      "quote": "Higen!",
      "block": 125
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "neu",
      "cue": "UJIO",
      "quote": "None must escape!",
      "block": 126
    },
    {
      "speaker": "p1",
      "to": "p7",
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "Whatever you do, don't stop.",
      "block": 127
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "opp",
      "cue": "GUARD",
      "quote": "Stop!   Don't come any closer!",
      "block": 128
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "opp",
      "cue": "GUARD",
      "quote": "Stop!   Somebody!",
      "block": 129
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "opp",
      "cue": "GUARD",
      "quote": "You stop!",
      "block": 130
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "opp",
      "cue": "GUARD",
      "quote": "It's not my responsibility...",
      "block": 131
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "neu",
      "cue": "GUARD",
      "quote": "Carry the equipment.",
      "block": 132
    },
    {
      "speaker": "p15",
      "to": "p7",
      "stance": "neu",
      "cue": "GUARD",
      "quote": "This way...",
      "block": 133
    },
    {
      "speaker": "p7",
      "to": null,
      "stance": "neu",
      "cue": "GRAHAM",
      "quote": "I think I'm going to be sick...",
      "block": 134
    },
    {
      "speaker": "p15",
      "to": null,
      "stance": "neu",
      "cue": "GUARD",
      "quote": "Photo... graph.",
      "block": 135
    },
    {
      "speaker": "p1",
      "to": "p8",
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "How's your poem coming?",
      "block": 136
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "The end is proving difficult.",
      "block": 137
    },
    {
      "speaker": "p7",
      "to": null,
      "stance": "ally",
      "cue": "GRAHAM",
      "quote": "An honor.",
      "block": 138
    },
    {
      "speaker": "p8",
      "to": "p1",
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "I thought you returned to America.",
      "block": 139
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "And how do you plan to do that?",
      "block": 140
    },
    {
      "speaker": "p7",
      "to": null,
      "stance": "ally",
      "cue": "GRAHAM",
      "quote": "I would be greatly honored.",
      "block": 141
    },
    {
      "speaker": "p9",
      "to": null,
      "stance": "ally",
      "cue": "NOBUTADA",
      "quote": "Hurry, this way!",
      "block": 142
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "Archers! Shoot! Shoot!",
      "block": 143
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "OMURA",
      "quote": "Can you see them?",
      "block": 144
    },
    {
      "speaker": "p17",
      "to": "p16",
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "What on earth -- ?",
      "block": 145
    },
    {
      "speaker": "p16",
      "to": "p17",
      "stance": "neu",
      "cue": "OMURA",
      "quote": "What is happening?",
      "block": 146
    },
    {
      "speaker": "p17",
      "to": "p16",
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "The attack has been stopped.",
      "block": 147
    },
    {
      "speaker": "p16",
      "to": "p17",
      "stance": "neu",
      "cue": "OMURA",
      "quote": "How is that possible?",
      "block": 148
    },
    {
      "speaker": "p16",
      "to": "p17",
      "stance": "neu",
      "cue": "OMURA",
      "quote": "How long will that take?",
      "block": 149
    },
    {
      "speaker": "p17",
      "to": "p16",
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "An hour.   Less.",
      "block": 150
    },
    {
      "speaker": "p18",
      "to": null,
      "stance": "neu",
      "cue": "SAMURAI",
      "quote": "Attack! Prepare to die!      Die...",
      "block": 151
    },
    {
      "speaker": "p19",
      "to": "p1",
      "stance": "neu",
      "cue": "SILENT SAMURAI",
      "quote": "ALGREN-SAN!",
      "block": 152
    },
    {
      "speaker": "p1",
      "to": "p19",
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "NO!!",
      "block": 153
    },
    {
      "speaker": "p16",
      "to": "p17",
      "stance": "neu",
      "cue": "OMURA",
      "quote": "We must call for reserves.",
      "block": 154
    },
    {
      "speaker": "p17",
      "to": "p16",
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "The reserves are a half hour back,\n                   damn it! We've thrown three\n                   thousand men at him and he's not\n                   even armed.",
      "block": 155
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "OMURA",
      "quote": "This is not possible --",
      "block": 156
    },
    {
      "speaker": "p17",
      "to": null,
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "Son-of-a-bitch thinks he can win.",
      "block": 157
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "OMURA",
      "quote": "Call up the reinforcements NOW!",
      "block": 158
    },
    {
      "speaker": "p14",
      "to": null,
      "stance": "neu",
      "cue": "UJIO",
      "quote": "Daijigozaran.",
      "block": 159
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "But now you live again.",
      "block": 160
    },
    {
      "speaker": "p1",
      "to": null,
      "stance": "neu",
      "cue": "ALGREN",
      "quote": "Yes.",
      "block": 161
    },
    {
      "speaker": "p8",
      "to": null,
      "stance": "neu",
      "cue": "KATSUMOTO",
      "quote": "It was not your time.",
      "block": 162
    },
    {
      "speaker": "p17",
      "to": null,
      "stance": "neu",
      "cue": "BAGLEY",
      "quote": "I'm taking command down there.",
      "block": 163
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "OMURA",
      "quote": "Bring up the new guns!",
