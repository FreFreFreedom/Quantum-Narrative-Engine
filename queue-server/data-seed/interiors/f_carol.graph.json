      "cue": "FRED HAYMES (signals to the STENOGRAPHER)",
      "quote": "This is off the record, honey.",
      "block": 87
    },
    {
      "speaker": "p4",
      "to": null,
      "stance": "neu",
      "cue": "CAROL",
      "quote": "Might as well be on the record.",
      "block": 88
    },
    {
      "speaker": "p4",
      "to": null,
      "stance": "ally",
      "cue": "CAROL",
      "quote": "No, Fred. Let me have my say.",
      "block": 89
    },
    {
      "speaker": "p11",
      "to": null,
      "stance": "neu",
      "cue": "CLERK (CONT’D)",
      "quote": "Hand delivered. Swank.",
      "block": 90
