      "quote": "Yeah?",
      "block": 127
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL",
      "quote": "Sure! I got eight hundred potatoes\n\tsays he goes one more... He\n\tretired, you know.",
