    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL",
      "quote": "This is Biederman, you guys.",
      "block": 116
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL",
      "quote": "Biederman, this is Son Loc, Tu Fon,\n\tHuckerbelly and Potts. What's the\n\tstory here, Biederman? We're\n\tlooking for... Wait a minute.",
      "block": 117
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "neu",
      "cue": "COLONEL (CONT'D)",
      "quote": "Here it is. Chez Armand.",
      "block": 118
    },
    {
      "speaker": "p21",
      "to": null,
      "stance": "neu",
      "cue": "WHORE",
      "quote": "Chez Armand not here! Chez Armand\n\thas gone to other spot!",
