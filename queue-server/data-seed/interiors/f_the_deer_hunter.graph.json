    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL (gets up)",
      "quote": "Honey, c'mere. Come right here.",
      "block": 120
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL (CONT'D)",
      "quote": "This is for bein' so smart.",
      "block": 121
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL (CONT'D)",
      "quote": "Let's go! Mount up! C'mon\n\tBiederman!",
      "block": 122
    },
    {
      "speaker": "p16",
      "to": "p6",
      "stance": "opp",
      "cue": "COLONEL (CONT'D)",
      "quote": "Boy, do I love this conflict.\n\tHuh?... What the hell were you\n\tdoin' in there?",
