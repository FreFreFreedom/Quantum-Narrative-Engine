    },
    {
      "speaker": "p6",
      "to": null,
      "stance": "neu",
      "cue": "NICK",
      "quote": "You know a guy named Merle?",
      "block": 124
    },
    {
      "speaker": "p16",
      "to": null,
      "stance": "ally",
      "cue": "COLONEL",
      "quote": "Merle? That's who we're looking\n\tfor. Merle.",
