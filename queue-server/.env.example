# Copy to .env for local dev. On Railway, set these as project variables instead.
PORT=8080
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
# Optional: absolute path for the SQLite file. Defaults to ./data/queue.db.
# On Railway's free tier this resets on every deploy unless you attach a volume (see README).
DB_PATH=

# ── Free-provider catalogue (services/ai/catalog.js) ─────────────────────────
# All optional. A provider is only ever used once its key is set here — a
# missing key is a silent skip, never a fallback default, so this is how you
# control which free providers the router (services/ai/router.js) is allowed
# to fall through to when the Claude Code subscription is exhausted. None of
# these are required for the app to run; they only widen the "always be able
# to run a model" fallback chain.
#
# These keys feed the AI Router provider (question-mode chat / text generation
# only — no file editing). For IMPLEMENT-mode coding tasks on free models, see
# the OpenCode section below instead.
GROQ_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
ZHIPU_API_KEY=

# ── OpenCode provider (free coding-agent execution) ──────────────────────────
# OpenCode (the opencode npm binary) is a full coding agent — it has its own
# agentic loop, file tools, bash, and session management. When you select
# "OpenCode" as the execution provider in the Dispatch Queue, the server
# spawns `opencode run` as a detached subprocess with the chosen model.
#
# CRITICAL: OpenCode reads its OWN provider credentials, independently of the
# catalogue keys above. The env vars below are passed through to the spawned
# OpenCode process (see services/providers/opencode.js#spawnEnv — it does NOT
# strip API keys, unlike the Claude Code provider). Set any keys for providers
# you want OpenCode to be able to use as backends:
#
#   OPENROUTER_API_KEY=     → Qwen3.8-Max, Qwen2.5-Coder (free :free variants available)
#   GOOGLE_AI_STUDIO_API_KEY= → Gemini Flash (free tier: ~1500 req/day)
#   GROQ_API_KEY=           → Llama-3.3-70b (free tier available)
#   OPENAI_API_KEY=         → GPT-4o (if you have free credits)
#   ANTHROPIC_API_KEY=      → Claude (if you have free credits)
#
# OpenCode ALSO provides built-in free models with NO key required:
#   opencode/deepseek-v4-flash-free  (tested — works for implement tasks)
#   opencode/big-pickle
#   opencode/nemotron-3-ultra-free
#   opencode/hy3-free, ling-3.0-tiny-free, mimo-v2.5-free,
#   opencode/nemotron-3.5-lightning-free
#
# Models are discovered automatically via `opencode models --verbose`
# (cached for 5 minutes). Free models (cost 0/0) sort to the top of the
# provider picker in the Dispatch Queue's New-prompt form.
#
# To use OpenCode on Railway, set OPENROUTER_API_KEY (or any of the above)
# as a project variable — the key flows to the spawned opencode process.
# No additional configuration is needed.
#
# ── Claude Code (subscription) ────────────────────────────────────────────────
# The Claude Code CLI is the default execution provider. On Railway, auth is
# via CLIAuth token (see CLAUDE_CODE_OAUTH_TOKEN). The spawned env strips
# ANTHROPIC_API_KEY to preserve subscription-billing (not metered API billing).
CLAUDE_CODE_OAUTH_TOKEN=

# ── TMDb film enrichment (services/filmEnrichment.js) ────────────────────────
# Free API key from https://www.themoviedb.org/settings/api (v3 key). Used to
# enrich film entities with synopsis/genres/keywords/country/cast. When unset,
# the enrich buttons simply report "key not configured" — nothing else breaks.
TMDB_API_KEY=

# ── GitHub discovery (services/codeDiscovery.js) ─────────────────────────────
# Optional. The "world's ideas" look and Building blocks search GitHub for real
# projects. Without a token GitHub allows only 10 searches/minute — with one
# (a free personal access token, no scopes needed) that rises to 30/minute.
# Create at https://github.com/settings/tokens — the search is read-only.
GITHUB_TOKEN=
