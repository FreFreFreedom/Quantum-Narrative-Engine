{
  "name": "fmcns-queue-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude-driven work queue, ported from the Orisha 'Travaux' spec for FMCNS. Step 1-2 of the suggested port order: DB + auth + WebSocket foundation, then a trimmed task runner.",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node server/src/index.js",
    "runner": "node scripts/queue-runner.js",
    "plan:send": "node scripts/send-plan.js",
    "tier:selftest": "node scripts/tier-selftest.js",
    "reset:selftest": "node scripts/resetwindow-selftest.js",
    "ship:selftest": "node scripts/ship-selftest.js",
    "next:selftest": "node scripts/nextsteps-selftest.js",
    "tidy:selftest": "node scripts/tidy-selftest.js",
    "ship:facts": "node scripts/shipfacts-selftest.js",
    "review:selftest": "node scripts/review-selftest.js",
    "notify:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/notify-selftest.js",
    "group:selftest": "node scripts/group-selftest.js",
    "witness:selftest": "node scripts/witness-selftest.js",
    "world:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/worldbrainstorm-selftest.js",
    "docs:sync": "node scripts/sync-docs.js",
    "idea:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/idealanded-selftest.js",
    "ideas:audit": "node scripts/ideas-audit.js",
    "ending:selftest": "node scripts/ending-selftest.js",
    "never-deep:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/never-deep-selftest.js",
    "notes:selftest": "node scripts/notes-selftest.js",
    "mentions:selftest": "node scripts/mentions-selftest.js",
    "scale:selftest": "node scripts/scale-ladder-selftest.js",
    "fences:anatomy": "node scripts/interior-fences.js",
    "dogville:anatomy": "node scripts/interior-dogville.js",
    "relations:selftest": "node scripts/relations-selftest.js",
    "peers:selftest": "node scripts/peers-selftest.js",
    "traffic:selftest": "node scripts/traffic-selftest.js",
    "queue:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/queue-model-selftest.js",
    "gaps:selftest": "node scripts/taggaps-selftest.js",
    "mind:selftest": "JWT_SECRET=selftest ADMIN_PASSWORD=selftest node scripts/mind-selftest.js",
    "room:selftest": "node scripts/room-selftest.mjs",
    "tensions:selftest": "node scripts/tensions-selftest.js",
    "signature:selftest": "node scripts/signature-selftest.js",
    "bonesearch:selftest": "node scripts/bonesearch-selftest.js",
    "splitscreen:selftest": "node scripts/splitscreen-selftest.js",
    "spectrum:selftest": "node scripts/spectrum-selftest.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.225",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "opencode-ai": "^1.18.16",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.5"
  }
}
